{
  "name": "arabic-radio",
  "productName": "راديو الوطن العربي",
  "version": "1.0.0",
  "description": "راديو بث مباشر من جميع الدول العربية",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.arabicradio",
    "productName": "راديو الوطن العربي",
    "files": [
      "index.html",
      "main.js",
      "icon.png"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
